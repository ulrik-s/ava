# Deploy via tagg: startas av ava-deploy.timer och kör deploy-latest-tag.sh,
# som bara gör något när en ny v*-tagg finns i origin. Samma deploy som för
# hand (deploy-prod.sh), bara utan handen. Loggen: journalctl -u ava-deploy.
#
# Installeras och uppdateras av deploy-prod.sh (idempotent):
#   install -m 644 tooling/systemd/ava-deploy.* /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now ava-deploy.timer

[Unit]
Description=AVA: deploya senaste v*-taggen om den inte redan är ute
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/srv/ava
ExecStart=/bin/bash tooling/scripts/deploy-latest-tag.sh
