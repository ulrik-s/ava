{
  "name": "ava",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "//browserslist": "Byggmål (#1299, docs/browser-support.md). POLICYN är de två senaste versionerna av Chrome, Edge, Firefox och Safari på desktop, samt iOS (Safari och Chrome — WebKit). Målen här är medvetet LÄGRE: Turbopack känner inte till de nyaste versionerna och skriver då om all modern syntax. Kod för en äldre version körs på alla nyare. test/unit/tooling/browserslist.test.ts låser att målen täcker policyn.",
  "browserslist": [
    "chrome 111",
    "edge 111",
    "firefox 111",
    "safari 16.4",
    "ios_saf 16.4"
  ],
  "scripts": {
    "dev": "concurrently -n next,cors -c blue,cyan \"next dev\" \"bun run dev:cors\"",
    "dev:next": "next dev",
    "dev:cors": "cors-proxy start -p 9999",
    "build": "next build",
    "build:demo": "DEMO_BASE_PATH=/ava bash tooling/scripts/build-demo.sh",
    "build:demo-repo": "bun tooling/scripts/build-demo-repo.ts",
    "size": "bun tooling/scripts/check-bundle-size.ts",
    "pin:actions": "bun tooling/scripts/pin-actions.ts",
    "demo:generate": "bun tooling/demo-generator/generate.ts",
    "demo:serve": "bash tooling/scripts/demo-serve.sh",
    "demo:serve:fast": "SKIP_BUILD=1 bash tooling/scripts/demo-serve.sh",
    "seed:local": "bun tooling/scripts/seed-firma-local.ts",
    "ava": "bun tooling/ava-cli/ava.ts",
    "ava:mcp": "bun tooling/ava-cli/ava-mcp.ts",
    "fortnox:connect": "bun tooling/scripts/fortnox-connect.ts",
    "ms:connect": "bun tooling/scripts/ms-connect.ts",
    "ms:smoke": "bun tooling/scripts/msgraph-smoke.ts",
    "ms:mail": "bash tooling/scripts/msgraph-mail-e2e.sh",
    "addin:build": "bun office-addin/build.ts",
    "addin:serve": "bun tooling/scripts/office-addin-serve.ts",
    "fortnox:e2e": "bun tooling/scripts/fortnox-e2e.ts",
    "fortnox:bookkeeping": "bun tooling/scripts/fortnox-bookkeeping-e2e.ts",
    "fortnox:series": "bun tooling/scripts/fortnox-series.ts",
    "server-first": "bun src/bin/server-first.ts",
    "server-first:build": "bun tooling/scripts/build-server-first.ts",
    "install:server": "bun tooling/scripts/install-server.ts",
    "bootstrap:admin": "bun tooling/scripts/bootstrap-admin.ts",
    "start": "next start",
    "tier3:up": "docker compose -f tooling/docker/docker-compose.yml up -d --build",
    "tier3:down": "docker compose -f tooling/docker/docker-compose.yml down",
    "tier3:restart": "docker compose -f tooling/docker/docker-compose.yml restart web",
    "tier3:logs": "docker compose -f tooling/docker/docker-compose.yml logs -f",
    "lint": "eslint --config tooling/config/eslint.config.mjs",
    "lint:suppress": "eslint --config tooling/config/eslint.config.mjs --suppress-all",
    "lint:prune": "eslint --config tooling/config/eslint.config.mjs --prune-suppressions",
    "lint:double-casts": "bun tooling/scripts/find-double-casts.ts",
    "commitlint": "commitlint --config tooling/config/commitlint.config.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json",
    "test": "bun tooling/scripts/run-tests.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun tooling/scripts/db-migrate.ts",
    "db:check-migrations": "bun tooling/scripts/check-migrations.ts",
    "test:run": "bun tooling/scripts/run-tests.ts",
    "test:watch": "bun test --isolate --watch --timeout 30000 test/unit test/integration test/scripts",
    "test:cov": "bun tooling/scripts/run-tests.ts --coverage",
    "test:fast": "bun tooling/scripts/run-tests.ts --fast",
    "test:sim": "AVA_SIM_HEAVY=1 bun test --timeout 600000 test/unit/server/sync/simulation/",
    "e2e": "playwright test --config tooling/config/playwright.config.ts",
    "e2e:ui": "playwright test --config tooling/config/playwright.config.ts --ui",
    "e2e:demo": "playwright test --config tooling/config/playwright-demo.config.ts",
    "e2e:install": "playwright install --with-deps chromium",
    "e2e:oidc": "bash tooling/scripts/e2e-oidc.sh",
    "e2e:doc-pipeline": "bash tooling/scripts/document-pipeline-e2e.sh",
    "e2e:billing": "bash tooling/scripts/billing-pipeline-e2e.sh",
    "e2e:billing-scenarios": "bash tooling/scripts/billing-scenarios-e2e.sh",
    "e2e:matter-flora": "bash tooling/scripts/matter-flora-e2e.sh",
    "e2e:reports": "bash tooling/scripts/reports-e2e.sh",
    "e2e:conflict-check": "bash tooling/scripts/conflict-check-e2e.sh",
    "e2e:invoice-dispatch": "bash tooling/scripts/invoice-dispatch-e2e.sh",
    "e2e:expected-receivable": "bash tooling/scripts/expected-receivable-e2e.sh",
    "e2e:camt-payment": "bash tooling/scripts/camt-payment-e2e.sh",
    "e2e:conflict": "bash tooling/scripts/conflict-e2e.sh",
    "selfhosted:local": "bash tooling/scripts/selfhosted-local.sh",
    "diagnose-ui": "bun tooling/scripts/diagnose-ui.ts",
    "smoke:tier3": "bash tooling/scripts/test-tier3-smoke.sh",
    "test:all": "bash tooling/scripts/test-all.sh",
    "load:test": "bash tooling/load/load-test.sh",
    "load:test:50": "LOAD_USERS=50 LOAD_ORGS=3 bash tooling/load/load-test.sh",
    "duplicates": "jscpd --config tooling/config/jscpd.json src",
    "lint:complexity-strict": "bun tooling/scripts/check-complexity-strict.ts",
    "deps:check": "depcruise --config tooling/config/dependency-cruiser.cjs --output-type err src test helper-ui office-addin tooling/ava-cli",
    "deps:graph": "depcruise --config tooling/config/dependency-cruiser.cjs --output-type dot src | dot -Tsvg > reports/dependency-graph.svg",
    "deps:archi": "depcruise --config tooling/config/dependency-cruiser.cjs --output-type archi src | dot -Tsvg > reports/architecture.svg",
    "knip": "knip --config tooling/config/knip.json",
    "knip:report": "knip --config tooling/config/knip.json --no-exit-code",
    "quality": "bun run typecheck && bun run lint && bun run test:cov && bun run duplicates && bun run deps:check && bun run knip:report",
    "quality:fast": "bun run typecheck && bun run lint && bun run file-size && bun run test:fast",
    "file-size": "bun tooling/scripts/file-size-ratchet.ts",
    "quality:report": "mkdir -p reports && bun run test:cov && bun run duplicates && bun run deps:check || true",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --config tooling/config/eslint.config.mjs --fix",
      "bash -c 'tsc --noEmit'"
    ]
  },
  "dependencies": {
    "@azure/msal-browser": "^5.29.0",
    "@js-temporal/polyfill": "^0.5.1",
    "@modelcontextprotocol/server": "2.4.0",
    "@tanstack/react-query": "^5.107.1",
    "@testing-library/dom": "^10.4.2",
    "@trpc/client": "^11.25.0",
    "@trpc/react-query": "^11.25.0",
    "@trpc/server": "^11.25.0",
    "clsx": "^2.1.1",
    "cron-parser": "^5.10.4",
    "dockview-react": "8.3.1",
    "handlebars": "^4.7.10",
    "jose": "^6.2.15",
    "json-logic-js": "^2.0.5",
    "lucide-react": "^1.70.0",
    "mammoth": "^1.13.0",
    "next": "16.4.5",
    "nodemailer": "^10.4.0",
    "pdfjs-dist": "6.2.108",
    "pg-boss": "^12.38.1",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@electric-sql/pglite": "^0.5.15",
    "@happy-dom/global-registrator": "^21.0.4",
    "@isomorphic-git/cors-proxy": "^3.0.3",
    "@modelcontextprotocol/client": "2.4.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/json-logic-js": "^2.0.8",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "browserslist": "^4.29.5",
    "bun-types": "^1.4.4",
    "concurrently": "^10.0.7",
    "dependency-cruiser": "^18.7.2",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "eslint": "^10.14.0",
    "eslint-config-next": "16.3.8",
    "eslint-plugin-import-x": "^4.18.0",
    "fake-indexeddb": "^6.2.7",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "jscpd": "^5.4.3",
    "knip": "6.16.1",
    "lint-staged": "17.0.7",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.65.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3"
  },
  "trustedDependencies": [
    "unrs-resolver"
  ],
  "//overrides": "CVE-tvingade versioner på TRANSITIVA beroenden (#966). Varje rad har en advisory bakom sig och det direkta beroendet kan inte bumpas dit själv. Ta bort en rad så fort uppströms hunnit ikapp — bun audit i Security-workflowen visar om den fortfarande behövs.",
  "overrides": {
    "@xmldom/xmldom": "^0.8.15",
